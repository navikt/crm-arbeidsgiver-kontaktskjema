    <description>Når en henvendelse opprettes fra kontaktskjemaet (TAG_Source__c = &quot;Kontaktskjema&quot;), opprettes den først som en enkel post uten alle nødvendige data og koblinger.
Flowen finner og setter:
Konto (hvis organisasjonsnummeret er feil, opprettes det en Application Log-post)
Kontakt (ved behov opprettes en ny kontakt)
Beriker henvendelsen med tema, undertema og melding
Setter riktig Nav-enhet/eier basert på konto, Nav region og tema
Oppretter e-postbekreftelse og legger den i kø for sending</description>
    <environments>Default</environments>
    <formulas>
        <name>FirstName</name>
        <dataType>String</dataType>
        <expression>IF(
  CONTAINS(TRIM({!$Record.TAG_WebFormContactName__c}), &quot; &quot;),
  LEFT(
    TRIM({!$Record.TAG_WebFormContactName__c}),
    FIND(&quot; &quot;, TRIM({!$Record.TAG_WebFormContactName__c})) - 1
  ),
  &quot;&quot;
)</expression>
    </formulas>
    <formulas>
        <name>LastName</name>
        <dataType>String</dataType>
        <expression>IF(
  CONTAINS(TRIM({!$Record.TAG_WebFormContactName__c}), &quot; &quot;),
  TRIM(
    RIGHT(
      TRIM({!$Record.TAG_WebFormContactName__c}),
      LEN(TRIM({!$Record.TAG_WebFormContactName__c})) - FIND(&quot; &quot;, TRIM({!$Record.TAG_WebFormContactName__c}))
    )
  ),
  TRIM({!$Record.TAG_WebFormContactName__c})
)</expression>
    </formulas>
    <formulas>
        <name>navUnitArbeidslivsenterName</name>
        <dataType>String</dataType>
        <expression>IF({!accountRecord.NAV_Region__c} = &quot;Øst-Viken&quot;, &quot;NAV Arbeidslivssenter Øst-Viken&quot;,
IF({!accountRecord.NAV_Region__c} = &quot;Oslo&quot;, &quot;NAV Arbeidslivssenter Oslo&quot;,
IF({!accountRecord.NAV_Region__c} = &quot;Innlandet&quot;, &quot;NAV Arbeidslivssenter Innlandet&quot;,
IF({!accountRecord.NAV_Region__c} = &quot;Vest-Viken&quot;, &quot;NAV Arbeidslivssenter Vest-Viken&quot;,
IF({!accountRecord.NAV_Region__c} = &quot;Vestfold og Telemark&quot;, &quot;NAV Arbeid og helse Vestfold og Telemark&quot;,
IF({!accountRecord.NAV_Region__c} = &quot;Agder&quot;, &quot;NAV Arbeidslivssenter Agder&quot;,
IF({!accountRecord.NAV_Region__c} = &quot;Rogaland&quot;, &quot;NAV Arbeidslivssenter Rogaland&quot;,
IF({!accountRecord.NAV_Region__c} = &quot;Vestland&quot;, &quot;NAV Arbeidslivssenter Vestland&quot;,
IF({!accountRecord.NAV_Region__c} = &quot;Møre og Romsdal&quot;, &quot;NAV Arbeidslivssenter Møre og Romsdal&quot;,
IF({!accountRecord.NAV_Region__c} = &quot;Nordland&quot;, &quot;NAV Arbeidslivssenter Nordland&quot;,
IF({!accountRecord.NAV_Region__c} = &quot;Troms og Finnmark&quot;, &quot;NAV Arbeidslivssenter Troms og Finnmark&quot;,
IF({!accountRecord.NAV_Region__c} = &quot;Trøndelag&quot;, &quot;NAV Arbeidslivssenter Trøndelag&quot;,
NULL
))))))))))))</expression>
    </formulas>
